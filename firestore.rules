rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Una cuenta es administradora cuando existe un documento con su UID
    // en la colección usuarios y conserva ambos valores activos.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.estatus == 'activo';
    }

    function validMachine() {
      return request.resource.data.keys().hasOnly([
          'name', 'plant', 'department', 'assetNumber', 'description'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.plant is string
        && request.resource.data.plant.size() > 0
        && request.resource.data.plant.size() <= 100
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0
        && request.resource.data.department.size() <= 100
        && request.resource.data.assetNumber is string
        && request.resource.data.assetNumber.size() > 0
        && request.resource.data.assetNumber.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1000;
    }

    function validRoutine() {
      return request.resource.data.activity is string
        && request.resource.data.activity.size() > 0
        && request.resource.data.activity.size() <= 500
        && request.resource.data.frequency is string
        && request.resource.data.frequency in ['Diaria', 'Semanal', 'Mensual', 'Trimestral']
        && request.resource.data.order is number
        && request.resource.data.order >= 1
        && request.resource.data.material is string
        && request.resource.data.material.size() <= 300
        && request.resource.data.ppe is string
        && request.resource.data.ppe.size() <= 300
        && request.resource.data.waste is string
        && request.resource.data.waste.size() <= 500;
    }

    function validImage() {
      return request.resource.data.file is bytes
        && request.resource.data.file.size() <= 184320
        && request.resource.data.mimeType == 'image/webp';
    }

    function validAudit() {
      return request.resource.data.machineId is string
        && request.resource.data.machineName is string
        && request.resource.data.plant is string
        && request.resource.data.department is string
        && request.resource.data.assetNumber is string
        && request.resource.data.week is string
        && request.resource.data.auditDate is string
        && request.resource.data.auditorUid == request.auth.uid
        && request.resource.data.auditorName is string
        && request.resource.data.compliance is number
        && request.resource.data.compliance >= 0
        && request.resource.data.compliance <= 100
        && request.resource.data.status is string
        && request.resource.data.totalActivities is number
        && request.resource.data.compliantActivities is number
        && request.resource.data.openFindings is number;
    }

    // El usuario autenticado puede leer únicamente su propio perfil.
    // Los perfiles se administran desde Firebase Console u otro sistema autorizado.
    match /usuarios/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Máquinas visibles para los operadores mediante su QR.
    match /machines/{machineId} {
      allow read: if true;
      allow create, update: if isAdmin() && validMachine();
      allow delete: if isAdmin();

      // Foto utilizada como portada de la tarjeta de máquina.
      match /images/{imageId} {
        allow read: if true;
        allow create, update: if isAdmin() && validImage();
        allow delete: if isAdmin();
      }

      // Actividades de mantenimiento de cada máquina.
      match /routines/{routineId} {
        allow read: if true;
        allow create, update: if isAdmin() && validRoutine();
        allow delete: if isAdmin();

        // Fotografía de referencia de una actividad.
        match /images/{imageId} {
          allow read: if true;
          allow create, update: if isAdmin() && validImage();
          allow delete: if isAdmin();
        }
      }
    }

    // Auditorías y hallazgos: información interna visible solo para administradores.
    match /audits/{auditId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validAudit();
      allow delete: if isAdmin();

      match /results/{resultId} {
        allow read, create, update, delete: if isAdmin();
      }

      match /findings/{findingId} {
        allow read, create, update, delete: if isAdmin();

        match /images/{imageId} {
          allow read: if isAdmin();
          allow create, update: if isAdmin() && validImage();
          allow delete: if isAdmin();
        }
      }
    }

    // Todo documento que no coincida con las rutas anteriores queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
